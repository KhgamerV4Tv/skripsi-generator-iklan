# Wajib untuk fitur utama
GEMINI_API_KEY = "replace-with-your-gemini-api-key"
OPENAI_API_KEY = "replace-with-your-openai-api-key"
ADMIN_PIN = "replace-with-a-strong-admin-pin"

# Opsional: pemeriksaan kemiripan visual dengan ImgBB + Google Lens/SerpAPI
IMGBB_API_KEY = "replace-with-your-imgbb-api-key"
SERPAPI_API_KEY = "replace-with-your-serpapi-api-key"

# Opsional: penyimpanan log penggunaan dan hasil UAT ke Firestore
[gcp_service_account]
type = "service_account"
project_id = "replace-with-project-id"
private_key_id = "replace-with-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "replace-with-service-account-email"
client_id = "replace-with-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "replace-with-client-certificate-url"
universe_domain = "googleapis.com"
